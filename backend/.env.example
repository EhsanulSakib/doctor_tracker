# ─── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=8082
LOG_LEVEL=info

# Origin allowed by CORS (the Next.js app)
FRONTEND_URL=http://localhost:3000

# Number of reverse proxies in front of the API (0 locally, 1 on Render).
# Lets rate limiting see the real client IP.
TRUST_PROXY=0

# ─── Database ──────────────────────────────────────────────
# Local (docker compose up -d) or a MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/doctor_tracker

# ─── Auth ──────────────────────────────────────────────────
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# ─── Seeded admin account (npm run seed) ───────────────────
ADMIN_NAME=Clinic Admin
ADMIN_EMAIL=admin@doctortracker.dev
ADMIN_PASSWORD=ChangeMe!2026
